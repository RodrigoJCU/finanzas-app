# =====================================================================
# FinanzasApp — Variables de entorno
#
# 1. Copia este archivo y renómbralo a:  .env.local
# 2. Rellena los valores. NUNCA subas .env.local a GitHub (ya está ignorado).
# 3. En Vercel, pega las mismas variables en: Project > Settings > Environment Variables.
#
# Cada bloque indica en qué FASE se necesita. Para la Fase 1 basta con el bloque de Supabase.
# =====================================================================


# ---------------------------------------------------------------------
# GENERAL (Fase 1)
# ---------------------------------------------------------------------
# En tu PC: http://localhost:3000
# En Vercel: la URL de tu proyecto, ej. https://finanzas-app.vercel.app (sin "/" al final)
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ---------------------------------------------------------------------
# SUPABASE (Fase 1) — https://supabase.com/dashboard
# Abre tu proyecto > botón "Connect" (arriba) o Project Settings > API Keys
# ---------------------------------------------------------------------
# "Project URL", ej. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "Publishable key" (empieza por sb_publishable_...). Es pública, puede ir al navegador.
# Si tu proyecto solo muestra claves "Legacy", usa la "anon public".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# "Secret key" (empieza por sb_secret_...). SECRETA: da acceso total a la base de datos.
# Si tu proyecto solo muestra claves "Legacy", usa la "service_role".
SUPABASE_SECRET_KEY=


# ---------------------------------------------------------------------
# CORREO ENTRANTE (Fase 2) — Una cuenta de Gmail NUEVA solo para la app
# Ej. finanzasapp.bot@gmail.com. Los usuarios reenviarán ahí los correos de su banco.
# ---------------------------------------------------------------------
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
# La dirección completa de esa cuenta de Gmail
IMAP_USER=
# "Contraseña de aplicación" de 16 letras (NO tu contraseña normal):
#   myaccount.google.com > Seguridad > activar "Verificación en 2 pasos"
#   luego myaccount.google.com/apppasswords > crear una llamada "FinanzasApp"
#   Pégala sin espacios.
IMAP_PASSWORD=


# ---------------------------------------------------------------------
# WHATSAPP — Meta Cloud API (Fase 2) — https://developers.facebook.com/apps
# Crear app > tipo "Business" > agregar producto "WhatsApp" > "API Setup"
# ---------------------------------------------------------------------
# "Temporary access token" sirve para probar (dura 24h). En Fase 2 te explico cómo
# crear uno permanente (System User en Business Settings).
WHATSAPP_ACCESS_TOKEN=
# "Phone number ID" (un número largo, NO es el número de teléfono)
WHATSAPP_PHONE_NUMBER_ID=
# El número de teléfono del bot en formato internacional sin "+", ej. 15551234567
NEXT_PUBLIC_WHATSAPP_BOT_NUMBER=
# Inventa una frase larga cualquiera; la pegarás también en Meta al configurar el webhook.
WHATSAPP_VERIFY_TOKEN=
# App settings > Basic > "App secret" (botón "Show")
WHATSAPP_APP_SECRET=
# Versión de la Graph API de Meta
WHATSAPP_API_VERSION=v23.0
# OPCIONAL (tiene costo por mensaje): nombre de una plantilla "Utility" aprobada en Meta para avisar de
# un gasto cuando el usuario lleva más de 24h sin escribir. Cuerpo sugerido de la plantilla:
#   "Nuevo movimiento: {{1}} en {{2}}. Respóndeme con la categoría."
# Déjalo vacío para costo $0: el gasto se guarda y se pregunta cuando el usuario vuelva a escribir.
WHATSAPP_TEMPLATE_NEW_TRANSACTION=
WHATSAPP_TEMPLATE_LANGUAGE=es


# ---------------------------------------------------------------------
# GOOGLE GEMINI (Fase 2) — https://aistudio.google.com/apikey
# "Create API key". El plan gratuito no pide tarjeta.
# ---------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest


# ---------------------------------------------------------------------
# STRIPE en modo prueba (Fase 3) — https://dashboard.stripe.com/test/apikeys
# Asegúrate de que el interruptor "Test mode" / "Sandbox" esté activado.
# ---------------------------------------------------------------------
# "Publishable key" (pk_test_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# "Secret key" (sk_test_...)
STRIPE_SECRET_KEY=
# Se obtiene al crear el webhook en Fase 3 (whsec_...)
STRIPE_WEBHOOK_SECRET=
# ID del precio de la suscripción mensual (price_...). Lo creamos en Fase 3.
STRIPE_PRICE_ID=
# ID del precio anual (price_...). Lo rellena npm run stripe:setup.
STRIPE_PRICE_ID_ANNUAL=
# Opcional: configuración del portal de cliente (lo rellena npm run stripe:setup).
STRIPE_PORTAL_CONFIGURATION_ID=


# ---------------------------------------------------------------------
# TAREAS PROGRAMADAS (Fase 2)
# Protege el endpoint que revisa el correo cada minuto. Genera un valor aleatorio con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------
CRON_SECRET=
